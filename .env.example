# ---------------------------------------------------------------------------
# Copy to .env.local. Every variable here is optional for a content-only
# contribution: the project must run without any of them so that a new
# contributor is never blocked. See docs/DEVELOPMENT_WORKFLOW.md.
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadata, sitemap and structured data.
# Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# PageSpeed Insights API key. Required only for /check (v1.1).
# Without it, the diagnostic degrades to an honest "unavailable" state.
PAGESPEED_API_KEY=

# Google Tag Manager container. Omit to disable analytics entirely in dev.
NEXT_PUBLIC_GTM_ID=
